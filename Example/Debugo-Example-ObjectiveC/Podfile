platform :ios, '15.0'

target 'Debugo-Example-ObjectiveC' do
  # Pods for Debugo-Example-ObjectiveC
  pod 'FMDB'
  pod 'AFNetworking', '~> 4.0'

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # AFNetworking 4.0.1 导入了一个较新 Xcode 视为私有的头文件。
  Dir.glob(File.join(installer.sandbox.root, 'AFNetworking/AFNetworking/*.m')).each do |file|
    contents = File.read(file)
    next unless contents.include?('#import <netinet6/in6.h>')
    File.chmod(0644, file)
    File.write(file, contents.gsub("#import <netinet6/in6.h>\n", ''))
  end
end
